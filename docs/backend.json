
{
  "entities": {
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a chat room or board.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["board", "chat"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "creatorId": { "type": "string" },
        "members": { "type": "object" },
        "password": { "type": "string" }
      },
      "required": ["id", "code", "createdAt", "creatorId", "members"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "color": { "type": "string" },
        "login": { "type": "string" }
      },
      "required": ["id", "username", "color"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "authorName": { "type": "string" },
        "authorColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "roomId", "userId", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/rooms/{roomId}": { "schema": { "$ref": "#/backend/entities/Room" }, "description": "Room metadata" },
    "/users/{userId}": { "schema": { "$ref": "#/backend/entities/User" }, "description": "User profiles" },
    "/rooms/{roomId}/messages/{messageId}": { "schema": { "$ref": "#/backend/entities/Message" }, "description": "Messages" }
  }
}
