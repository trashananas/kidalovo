{
  "entities": {
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a chat room where users can send and move messages.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Room entity."
        },
        "code": {
          "type": "string",
          "description": "The 4-letter code required to join the room."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the room was created.",
          "format": "date-time"
        },
        "creatorId": {
          "type": "string",
          "description": "The UID of the user who created the room."
        },
        "members": {
          "type": "object",
          "description": "A map of user UIDs to their roles (e.g., 'owner', 'member')."
        }
      },
      "required": [
        "id",
        "code",
        "createdAt",
        "creatorId",
        "members"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user who can create and join rooms, and send messages.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "username": {
          "type": "string",
          "description": "The username of the user."
        }
      },
      "required": [
        "id",
        "username"
      ]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a message sent within a room.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Message entity."
        },
        "roomId": {
          "type": "string",
          "description": "Reference to Room. (Relationship: Room 1:N Message)"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Message)"
        },
        "text": {
          "type": "string",
          "description": "The text content of the message."
        },
        "file": {
          "type": "object",
          "description": "An attached file, stored as a data URI or a URL from a cloud storage provider.",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the file."
            },
            "type": {
              "type": "string",
              "description": "The MIME type of the file."
            },
            "url": {
              "type": "string",
              "description": "The URL or data URI of the file."
            }
          },
          "required": [
            "name",
            "type",
            "url"
          ]
        },
        "position": {
          "type": "object",
          "description": "The coordinates of the message's position on the board.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "size": {
          "type": "object",
          "description": "The dimensions of the message card.",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the message was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "roomId",
        "userId",
        "position",
        "createdAt"
      ]
    },
    "DrawingObject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DrawingObject",
      "type": "object",
      "description": "Represents a single object drawn on the board, like a path, arrow, or shape.",
      "properties": {
        "userId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "path",
            "arrow",
            "rectangle",
            "ellipse",
            "triangle"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        },
        "color": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "type",
        "points",
        "color",
        "strokeWidth",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/backend/entities/Room"
      },
      "description": "Stores room metadata, including the join code and creation timestamp."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/User"
      },
      "description": "Stores user information."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/backend/entities/Message"
      },
      "description": "Stores messages within a room. Includes denormalized 'roomId' for authorization independence."
    },
    "/rooms/{roomId}/drawings/{drawingId}": {
      "schema": {
        "$ref": "#/backend/entities/DrawingObject"
      },
      "description": "Stores individual drawing objects within a room."
    }
  }
}
