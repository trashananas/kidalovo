rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorized() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isGlobalAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email == 'ananas@kidalovo.internal';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingDoc() {
      return resource != null;
    }

    function isRoomMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && (
        (room != null && room.get('members', {}) != null && request.auth.uid in room.members) || 
        isGlobalAdmin()
      );
    }

    function isRoomOwner(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && (
        (room != null && room.get('members', {}) != null && room.members.get(request.auth.uid, {}).get('role', '') == 'owner') || 
        isGlobalAdmin()
      );
    }
    
    function isLastMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && (
        (room != null && room.get('members', {}) != null && room.members.size() == 1 && request.auth.uid in room.members) || 
        isGlobalAdmin()
      );
    }

    function isMessageCreator() {
      return request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'system';
    }

    function isDrawingCreator() {
      return request.resource.data.userId == request.auth.uid;
    }

    function hasContent() {
      let data = request.resource.data;
      return (data.get('text', '') != null && data.get('text', '').size() > 0) 
          || (data.get('file', null) != null) || data.get('type', '') == 'audit';
    }

    function isMessageOwner() {
      return resource.data.userId == request.auth.uid;
    }

    function isMessageUpdateValid() {
      let incoming = request.resource.data;
      let existing = resource.data;
      return incoming.userId == existing.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isGlobalAdmin();
      allow create: if isOwner(userId);
      allow list: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.creatorId == request.auth.uid || isGlobalAdmin());
      allow update: if isRoomOwner(roomId) || 
        (isSignedIn() && (!resource.data.get('onlyAuthorized', false) || isAuthorized())) || isGlobalAdmin();
      allow delete: if (isLastMember(roomId) && isExistingDoc()) || isGlobalAdmin();

      match /messages/{messageId} {
        // Audit log only for Ananas
        allow read, list: if isRoomMember(roomId) && (resource.data.get('type', '') != 'audit' || isGlobalAdmin());
        allow create: if isRoomMember(roomId) && isMessageCreator() && hasContent() && request.resource.data.get('type', '') != 'audit';
        allow update: if (isMessageOwner() || (isRoomOwner(roomId) && isAuthorized()) || isGlobalAdmin()) && isExistingDoc() && isMessageUpdateValid() && resource.data.get('type', '') != 'audit';
        allow delete: if (isMessageOwner() || (isRoomOwner(roomId) && isAuthorized()) || isLastMember(roomId) || isGlobalAdmin()) && resource.data.get('type', '') != 'audit';
      }
      
      match /drawings/{drawingId} {
        allow read, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isDrawingCreator();
        allow delete: if isRoomMember(roomId) || isGlobalAdmin();
        allow update: if isRoomMember(roomId) || isGlobalAdmin();
      }
    }
  }
}