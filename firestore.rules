rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Проверка членства в комнате (поддерживает как булево значение, так и объект)
    function isRoomMember(data) {
      return isSignedIn() && data.members != null && data.members.keys().hasAll([request.auth.uid]);
    }

    // Проверка членства для сообщений (денормализованные данные)
    function isMessageMember(data) {
      return isSignedIn() && data.roomMembers != null && data.roomMembers.keys().hasAll([request.auth.uid]);
    }

    match /userProfiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Псевдоним для коллекции пользователей
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    match /rooms/{roomId} {
      // Разрешаем get для проверки существования и метаданных (пароль, тип доступа)
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 

      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      
      // Разрешаем обновление, если пользователь добавляет себя в участники 
      // или если он уже является владельцем/участником
      allow update: if isSignedIn() && (
        isRoomMember(resource.data) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );
      
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if isMessageMember(resource.data) || (isSignedIn() && resource.data.roomCreatorId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.roomCreatorId == request.auth.uid);
      }

      match /drawings/{drawingId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.creatorId == request.auth.uid);
      }
      
      match /file_chunks/{fileId}/chunks/{chunkId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}