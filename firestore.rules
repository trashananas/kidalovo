rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the user is not anonymous (registered with login/password).
     */
    function isAuthorized() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    /**
     * Returns true if the authenticated user is the global admin "Ananas".
     */
    function isGlobalAdmin() {
      return isSignedIn() && request.auth.token.get('name', '') == 'Ananas';
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the document being accessed already exists.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Returns true if the user is a member of the specified room.
     */
    function isRoomMember(roomId) {
      return isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members || isGlobalAdmin());
    }

    /**
     * Returns true if the user is the owner of the specified room.
     */
    function isRoomOwner(roomId) {
      return isSignedIn() && (get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid] == 'owner' || isGlobalAdmin());
    }
    
    /**
     * Returns true if the current user is the only member of the specified room.
     */
    function isLastMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && (room.members.size() == 1 && request.auth.uid in room.members) || isGlobalAdmin();
    }

    /**
     * Validates that an incoming message on create has the creator's UID.
     */
    function isMessageCreator() {
      return request.resource.data.userId == request.auth.uid;
    }

    /**
     * Validates that an incoming drawing on create has the creator's UID.
     */
    function isDrawingCreator() {
      return request.resource.data.userId == request.auth.uid;
    }

    /**
     * Validates that an incoming message has content (text or a file).
     */
    function hasContent() {
      let data = request.resource.data;
      return (data.get('text', '') != null && data.get('text', '').size() > 0) 
          || (data.get('file', null) != null);
    }

    /**
     * Validates that the current user is the owner of an existing message.
     */
    function isMessageOwner() {
      return resource.data.userId == request.auth.uid;
    }

    /**
     * Validates that immutable fields of a message are not changed on update.
     */
    function isMessageUpdateValid() {
      let incoming = request.resource.data;
      let existing = resource.data;
      return incoming.userId == existing.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isGlobalAdmin();
      allow create: if isOwner(userId);
      allow list: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.creatorId == request.auth.uid || isGlobalAdmin());
      allow update: if isRoomOwner(roomId) || 
        (isSignedIn() && request.resource.data.members.size() >= resource.data.members.size()) || isGlobalAdmin();
      allow delete: if (isLastMember(roomId) && isExistingDoc()) || isGlobalAdmin();

      match /messages/{messageId} {
        allow read, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isMessageCreator() && hasContent();
        allow update: if (isMessageOwner() || (isRoomOwner(roomId) && isAuthorized()) || isGlobalAdmin()) && isExistingDoc() && isMessageUpdateValid();
        allow delete: if isMessageOwner() || (isRoomOwner(roomId) && isAuthorized()) || isLastMember(roomId) || isGlobalAdmin();
      }
      
      match /drawings/{drawingId} {
        allow read, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isDrawingCreator();
        allow delete: if isRoomMember(roomId) || isGlobalAdmin();
        allow update: if isRoomMember(roomId) || isGlobalAdmin();
      }
    }
  }
}