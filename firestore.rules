rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the user is not anonymous (registered with login/password).
     */
    function isAuthorized() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the document being accessed already exists.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Returns true if the user is a member of the specified room.
     * Checks the parent room document as the single source of truth.
     */
    function isRoomMember(roomId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    /**
     * Returns true if the user is the owner of the specified room.
     * Checks for the 'owner' role in the parent room's members map.
     */
    function isRoomOwner(roomId) {
      return isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid] == 'owner';
    }
    
    /**
     * Returns true if the current user is the only member of the specified room.
     */
    function isLastMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && room.members.size() == 1 && request.auth.uid in room.members;
    }

    /**
     * Validates that an incoming message on create has the creator's UID.
     */
    function isMessageCreator() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    /**
     * Validates that an incoming drawing object on create has the creator's UID.
     */
    function isDrawingCreator() {
      return request.resource.data.userId == request.auth.uid;
    }

    /**
     * Validates that an incoming message has content (text or a file).
     */
    function hasContent() {
      let data = request.resource.data;
      return (data.text != null && data.text is string && data.text.size() > 0) 
          || (data.file != null && data.file.url != null && data.file.url is string && data.file.url.size() > 0);
    }

    /**
     * Validates that the current user is the owner of an existing message.
     */
    function isMessageOwner() {
      return resource.data.userId == request.auth.uid;
    }

    /**
     * Validates that immutable fields of a message are not changed on update.
     * Allow only 'text', 'position', 'size', and 'updatedAt' to be changed.
     */
    function isMessageUpdateValid() {
      let incoming = request.resource.data;
      let existing = resource.data;
      
      let fileUnchanged = (existing.file == null && incoming.file == null) || 
                          (existing.file.name == incoming.file.name && 
                           existing.file.type == incoming.file.type && 
                           existing.file.url == incoming.file.url);
                           
      return incoming.userId == existing.userId &&
             incoming.roomId == existing.roomId &&
             incoming.createdAt == existing.createdAt &&
             fileUnchanged;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId);
      allow list: if false;
    }

    match /rooms/{roomId} {
      // Any signed in user can check if a room exists.
      allow get: if isSignedIn();
      allow list: if false;
      // Only the creator can create the room.
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // The owner can update anything. Members can be added, but not removed by non-owners.
      allow update: if isRoomOwner(roomId) || 
        (isSignedIn() && request.resource.data.members.size() >= resource.data.members.size());
      // A room can be deleted only by the last member remaining.
      allow delete: if isLastMember(roomId) && isExistingDoc();

      match /messages/{messageId} {
        allow read, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isMessageCreator() && hasContent();
        allow update: if (isMessageOwner() || (isRoomOwner(roomId) && isAuthorized())) && isExistingDoc() && isMessageUpdateValid();
        allow delete: if isMessageOwner() || (isRoomOwner(roomId) && isAuthorized()) || isLastMember(roomId);
      }
      
      match /drawings/{drawingId} {
        allow read, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && isDrawingCreator();
        allow delete: if isRoomMember(roomId);
        allow update: if isRoomMember(roomId);
      }
    }
  }
}