
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ananas@kidalovo.internal' || 
        request.auth.uid == 'TTw3ZuEvyXerRBc7jr90PESYdcy1' ||
        request.auth.uid == 'Csr3hpbOWPbbcdP72cOKHp51NOa2'
      );
    }

    match /users/{userId} {
      allow read, write: if isGlobalAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if isGlobalAdmin();
      allow create: if isSignedIn();
      allow delete: if isGlobalAdmin() || (isSignedIn() && (resource.data.creatorId == request.auth.uid));
      allow update: if isGlobalAdmin() || isSignedIn();

      match /messages/{messageId} {
        allow read, list: if isSignedIn();
        allow create: if isGlobalAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'system'));
        allow update, delete: if isGlobalAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid));
      }
      
      match /drawings/{drawingId} {
        allow read, list: if isSignedIn();
        allow create: if isGlobalAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
        allow delete, update: if isGlobalAdmin() || isSignedIn();
      }
    }
  }
}
